# ===========================================
# Buffett Bot Configuration
# ===========================================
# Copy this file to .env and fill in your keys
# NEVER commit .env to version control

# -----------------------------
# Required API Keys
# -----------------------------

# Anthropic Claude API
# Sign up: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Finnhub (free tier: 60 requests/min)
# Sign up: https://finnhub.io/
# Used for: analyst price targets, news monitoring
FINNHUB_API_KEY=your_finnhub_api_key_here

# NOTE: yfinance is used for stock data (no API key needed)

# -----------------------------
# Optional: Paper Trading
# -----------------------------

# Alpaca (paper trading is free)
# Sign up: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true

# -----------------------------
# Notifications (pick one or more)
# -----------------------------

# Option 1: Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_TO=your_email@gmail.com

# Option 2: Telegram Bot
# 1. Create bot via @BotFather on Telegram
# 2. Get your chat ID from @userinfobot
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Option 3: Ntfy.sh (simple push notifications)
# 1. Install ntfy app on phone
# 2. Pick a unique topic name
# NTFY_TOPIC=buffett-bot-yourname
# NTFY_SERVER=https://ntfy.sh

# Option 4: Discord Webhook
# 1. In Discord: Server Settings → Integrations → Webhooks
# 2. Create webhook, copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# -----------------------------
# Bot Configuration
# -----------------------------

# How many companies to analyze deeply per month
MAX_DEEP_ANALYSES=10

# Portfolio value (for position sizing calculations)
PORTFOLIO_VALUE=50000

# Maximum single position size (0.15 = 15%)
MAX_POSITION_PCT=0.15

# Kill switch: set to false to disable weekly auto-trading
# (Alpaca keys stay configured, manual trades still work)
AUTO_TRADE_ENABLED=false

# Separate opt-in for orders submitted during a manually run briefing.
# Generating a briefing never implies trading unless this is true.
BRIEFING_PAPER_TRADES_ENABLED=false

# Set to false to disable automated monthly briefing
# (you can still run manually: docker compose run --rm buffett-bot)
MONTHLY_BRIEFING_ENABLED=false

# Paid scheduler jobs are independently opt-in. The manual Docker profile is
# unaffected by these switches.
WEDNESDAY_HAIKU_ENABLED=false
FRIDAY_SONNET_ENABLED=false
DAILY_NEWS_ANALYSIS_ENABLED=false

# Maximum sector concentration (0.30 = 30%)
MAX_SECTOR_PCT=0.30

# Database path
DATABASE_PATH=./data/buffett_bot_v2.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# -----------------------------
# v2.0: Analysis & Tiering
# -----------------------------

# Use Batch API for 50% cost reduction (true/false)
USE_BATCH_API=true

# Run Opus contrarian review on S-tier picks (true/false)
USE_OPUS_SECOND_OPINION=false

# Claude models. Override to roll a model back without rebuilding the image.
#   deep  = company analysis, light = news/quick screens, opus = second opinion
ANTHROPIC_MODEL_DEEP=claude-sonnet-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
ANTHROPIC_MODEL_OPUS=claude-opus-5

# Quarantine of non-tradable (delisted) holdings. Such a position keeps
# appearing in the broker's equity at a frozen mark; the bot excludes it from
# equity, sizing, slot counts and the sell engine, and alerts instead — it
# cannot sell it, so resolution is manual.
QUARANTINE_ALERTS_ENABLED=true
QUARANTINE_REALERT_DAYS=7
ASSET_STATUS_CACHE_HOURS=6

# Daily health check (22:30) — asserts the bot's own outputs are sane and
# alerts on Discord. A new or changed problem alerts immediately; an unchanged
# one repeats on HEALTH_REALERT_DAYS rather than nagging daily.
# Run on demand with: python -m scripts.health_check
HEALTH_CHECKS_ENABLED=true
HEALTH_REALERT_DAYS=7

# Benchmark index to compare picks against
BENCHMARK_SYMBOL=SPY

# Maximum number of concentrated positions (ASK portfolio)
MAX_POSITIONS=8

# Annual ASK contribution limit in DKK
ASK_CONTRIBUTION_LIMIT=135900

# Discount applied when deriving a target entry from external fair value
MARGIN_OF_SAFETY_PCT=25

# Alert when a B-tier stock is within this % of target entry price
TIER1_PROXIMITY_ALERT_PCT=10

# -----------------------------
# v2 Phase 2: SEC EDGAR 10-K ingestion
# -----------------------------

# SEC fair-access requires a descriptive User-Agent with a contact email,
# or requests are blocked. Without this, deep analyses fall back to the
# yfinance-derived summary (no real 10-K text). Format: "AppName email@host".
EDGAR_USER_AGENT=BuffettBot your_email@example.com

# -----------------------------
# v2 Phase 5: DKK / FX bridge
# -----------------------------

# Manual USD->DKK rate (DKK per 1 USD) for offline use / tests.
# Unset → live daily fetch via yfinance (DKK=X). Example: 6.85
# USDDKK_OVERRIDE=6.85
